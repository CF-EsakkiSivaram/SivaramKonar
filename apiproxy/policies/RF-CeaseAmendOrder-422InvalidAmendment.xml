<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<RaiseFault continueOnError="false" enabled="true" name="RF-CeaseAmendOrder-422InvalidAmendment">
  <DisplayName>RF-CeaseAmendOrder-422InvalidAmendment</DisplayName>
  <Properties/>
  <FaultResponse>
    <AssignVariable>
      <Name>errMsg</Name>
      <Template>["Order amendment request is invalid"]</Template>
    </AssignVariable>
    <AssignVariable>
      <Name>errCode</Name>
      <Value>INVALID_REQUEST</Value>
    </AssignVariable>
    <Set>
      <StatusCode>422</StatusCode>
    </Set>
  </FaultResponse>
  <IgnoreUnresolvedVariables>true</IgnoreUnresolvedVariables>
</RaiseFault>
