<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<RaiseFault continueOnError="false" enabled="true" name="RF-ReserveAppointment-422-Timeslot">
  <DisplayName>RF-ReserveAppointment-422-Timeslot</DisplayName>
  <Properties/>
  <FaultResponse>
    <AssignVariable>
      <Name>errMsg</Name>
      <Template>["The provided timeslot start time and/or end time is invalid."]</Template>
    </AssignVariable>
    <AssignVariable>
      <Name>errCode</Name>
      <Value>INVALID_REQUEST</Value>
    </AssignVariable>
    <Set>
      <StatusCode>422</StatusCode>
    </Set>
  </FaultResponse>
  <IgnoreUnresolvedVariables>true</IgnoreUnresolvedVariables>
</RaiseFault>
