<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<ProxyEndpoint name="default">
    <FaultRules/>
    <DefaultFaultRule name="all">
        <AlwaysEnforce>false</AlwaysEnforce>
        <Step>
            <Name>FC-Custom-Errors</Name>
        </Step>
    </DefaultFaultRule>
    <PreFlow name="PreFlow">
        <Request>
            <Step>
                <Name>FC-PreRequest</Name>
            </Step>
            <Step>
                <Name>AM-RemoveHeader-APIKey</Name>
            </Step>
        </Request>
        <Response/>
    </PreFlow>
    <Flows>
        <Flow name="Reassign">
            <Description/>
            <Request>
                <Step>
                    <Name>OAS-Reassign-ValidateRequest</Name>
                </Step>
            </Request>
            <Response/>
            <Condition>(proxy.pathsuffix MatchesPath "/0.0/reassign") and (request.verb = "POST")</Condition>
        </Flow>
        <Flow name="AddNotes">
            <Description>To add notes to customer interactions</Description>
            <Request>
                <Step>
                    <Name>OAS-AddNotes-ValidateRequest</Name>
                </Step>
            </Request>
            <Response/>
            <Condition>(proxy.pathsuffix MatchesPath "/0.0/add-note") and (request.verb = "POST")</Condition>
        </Flow>
        <Flow name="CloseWorkItem">
            <Description/>
            <Request>
                <Step>
                    <Name>OAS-CloseWorkItem-ValidateRequest</Name>
                </Step>
            </Request>
            <Response/>
            <Condition>(proxy.pathsuffix MatchesPath "/0.0/close") and (request.verb = "POST")</Condition>
        </Flow>
        <Flow name="CreateWorkItem">
            <Description/>
            <Request>
                <Step>
                    <Name>OAS-CreateWorkItem-ValidateRequest</Name>
                </Step>
                <Step>
                    <Name>EV-CreateWorkItem-GetReqFields</Name>
                </Step>
                <Step>
                    <Name>JS-CreateWorkItem-GetHobsReasonsFields</Name>
                </Step>
                <Step>
                    <Name>AM-CreateWorkItem-BuildRequest</Name>
                </Step>
            </Request>
            <Response/>
            <Condition>(proxy.pathsuffix MatchesPath "/0.0/create") and (request.verb = "POST")</Condition>
        </Flow>
        <Flow name="GetWorkItemDetails">
            <Description/>
            <Request>
                <Step>
                    <Name>OAS-GetWorkItemDetails-ValidateRequest</Name>
                </Step>
            </Request>
            <Response/>
            <Condition>(proxy.pathsuffix MatchesPath "/0.0/get") and (request.verb = "POST")</Condition>
        </Flow>
    </Flows>
    <PostFlow name="PostFlow">
        <Request/>
        <Response/>
    </PostFlow>
    <PostClientFlow>
        <Request/>
        <Response>
            <Step>
                <Name>FC-Custom-Logger</Name>
                <Condition>propertyset.API_Config.Hobs-WorkItem_debugLog = true</Condition>
            </Step>
        </Response>
    </PostClientFlow>
    <HTTPProxyConnection>
        <BasePath>/dev/work-item-dummy/v1</BasePath>
    </HTTPProxyConnection>
    <RouteRule name="Reassign">
        <TargetEndpoint>Reassign</TargetEndpoint>
        <Condition>(proxy.pathsuffix MatchesPath "/0.0/reassign")</Condition>
    </RouteRule>
    <RouteRule name="AddNotes">
        <TargetEndpoint>AddNotes</TargetEndpoint>
        <Condition>(proxy.pathsuffix MatchesPath "/0.0/add-note")</Condition>
    </RouteRule>
    <RouteRule name="CloseWorkItem">
        <TargetEndpoint>CloseWorkItem</TargetEndpoint>
        <Condition>(proxy.pathsuffix MatchesPath "/0.0/close")</Condition>
    </RouteRule>
    <RouteRule name="CreateWorkItem">
        <TargetEndpoint>CreateWorkItem</TargetEndpoint>
        <Condition>(proxy.pathsuffix MatchesPath "/0.0/create")</Condition>
    </RouteRule>
    <RouteRule name="GetWorkItemDetails">
        <TargetEndpoint>GetWorkItemDetails</TargetEndpoint>
        <Condition>(proxy.pathsuffix MatchesPath "/0.0/get")</Condition>
    </RouteRule>
</ProxyEndpoint>