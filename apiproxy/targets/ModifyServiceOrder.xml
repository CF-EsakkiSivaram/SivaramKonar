<?xml version="1.0" encoding="UTF-8"?><TargetEndpoint name="ModifyServiceOrder">
  <Description/>
  <FaultRules/>
  <DefaultFaultRule name="all">
    <AlwaysEnforce>true</AlwaysEnforce>
    <Step>
      <Name>FC-Custom-TargetErrors_Supernova</Name>
    </Step>
  </DefaultFaultRule>
  <PreFlow name="PreFlow">
    <Request>
      <Step>
        <Name>AM-RemovePathSuffix</Name>
      </Step>
    </Request>
    <Response/>
  </PreFlow>
  <Flows/>
  <PostFlow name="PostFlow">
    <Request/>
    <Response>
      <Step>
        <Name>EV-ModifyServiceOrder-GetHobsOrderId</Name>
      </Step>
      <Step>
        <Condition>(statusCode == "0000")</Condition>
        <Name>AM-ModifyServiceOrder-SetVFResponse</Name>
      </Step>
    </Response>
  </PostFlow>
  <HTTPTargetConnection>
    <URL>https://ec2-18-170-114-164.eu-west-2.compute.amazonaws.com/hobsrestgateway/omvalidationservice/ordergateway/productorder/changePackage</URL>
  </HTTPTargetConnection>
</TargetEndpoint>